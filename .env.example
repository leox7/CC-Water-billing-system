# Copy this file to .env and fill in real values. Never commit .env.
# Placeholders only in this file.

# development, test or production
APP_ENV=development
# true shows /docs and debug pages. Must be false (or missing) in production.
DEBUG=true

# Application database. Local development uses the limited user made by
# scripts/dev_db_setup.sql, never root.
DATABASE_URL=mysql+pymysql://water_dev:change-me@127.0.0.1:3306/water_billing_dev
# Used instead of DATABASE_URL when APP_ENV=test, so tests never touch real data.
TEST_DATABASE_URL=mysql+pymysql://water_dev:change-me@127.0.0.1:3306/water_billing_test

# Random, at least 32 bytes. Production refuses to start with this example value.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-random-value-of-at-least-32-bytes
SESSION_LIFETIME_DAYS=7

# console prints the SMS instead of sending it. africastalking is production only, except for
# Africa's Talking's test account: SMS_BACKEND=africastalking with AT_USERNAME=sandbox and the
# sandbox app's API key. That sends nothing to a real phone (messages show in their simulator).
SMS_BACKEND=console
AT_USERNAME=
AT_API_KEY=

# Strict-Transport-Security lifetime in seconds. 0 leaves it off. Turn on only
# once HTTPS works (DEPLOYMENT.md section 11.3).
HSTS_SECONDS=0

# Defaults for a new customer (PRD CUS-1)
DEFAULT_RATE_PER_UNIT=130.00
DEFAULT_SERVICE_CHARGE=150.00
