# Copy this file to .env and fill in real values. Never commit .env.
# Placeholders only in this file.

# development, test or production
APP_ENV=development
# true shows /docs and debug pages. Must be false (or missing) in production.
DEBUG=true

# Application database, for the Docker setup (README, DEPLOYMENT.md section 7). The host is the
# service name water-db, never localhost and never db. water_app is the limited user made in
# DEPLOYMENT.md 6.4. Use a hex password (openssl rand -hex 24) so it needs no escaping.
DATABASE_URL=mysql+pymysql://water_app:<APP_PASSWORD>@water-db:3306/water_billing
# Running the app directly on your computer instead (no Docker)? Use the limited user made by
# scripts/dev_db_setup.sql, never root, and this line in place of the one above:
# DATABASE_URL=mysql+pymysql://water_dev:change-me@127.0.0.1:3306/water_billing_dev
# Used instead of DATABASE_URL when APP_ENV=test, so tests never touch real data.
TEST_DATABASE_URL=mysql+pymysql://water_dev:change-me@127.0.0.1:3306/water_billing_test

# Random, at least 32 bytes. Production refuses to start with this example value.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-random-value-of-at-least-32-bytes
SESSION_LIFETIME_DAYS=7

# How an SMS leaves the system. One of: console, phone, africastalking. A change needs a restart.
# - console: prints the SMS in the log instead of sending it. Development and tests.
# - phone: the app prepares each SMS and a user sends it from their own phone (Messages to
#   send, on the Bills page). Sends nothing itself, so it works anywhere and needs no AT_ values.
# - africastalking: sent automatically. Production only (the bulk SMS endpoint has no sandbox),
#   and needs AT_USERNAME, AT_API_KEY and an approved AT_SENDER_ID.
SMS_BACKEND=console
AT_USERNAME=
AT_API_KEY=
# Stays empty until Africa's Talking approves the sender ID. 1 to 11 letters, digits, - or _.
# The app will not start with SMS_BACKEND=africastalking while this is empty.
AT_SENDER_ID=

# Strict-Transport-Security lifetime in seconds. 0 leaves it off. Turn on only
# once HTTPS works (DEPLOYMENT.md section 11.3).
HSTS_SECONDS=0

# Defaults for a new customer (PRD CUS-1)
DEFAULT_RATE_PER_UNIT=130.00
DEFAULT_SERVICE_CHARGE=150.00
