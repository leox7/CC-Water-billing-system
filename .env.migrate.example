# Copy to .env.migrate and fill in. Never commit .env.migrate. Placeholders only in this file.
# The migration user may change the table structure. It is used for one-off migration runs
# only (DEPLOYMENT.md 9.1), never by the running app. The password is the one given to
# water_migrate in DEPLOYMENT.md 6.4.
DATABASE_URL=mysql+pymysql://water_migrate:<MIGRATE_PASSWORD>@water-db:3306/water_billing
